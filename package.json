{
  "name": "mundomotos",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Mundo Motos, a motorcycle parts store and repair shop.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mundomotos/web dev",
    "dev:lan": "node scripts/lan-url.mjs 3000 && pnpm --filter @mundomotos/web dev:lan",
    "preview": "pnpm build && pnpm --filter @mundomotos/api dev",
    "preview:lan": "pnpm build && node scripts/lan-url.mjs 8787 && pnpm --filter @mundomotos/api dev:lan",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@mundomotos/eslint-config": "workspace:*",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
