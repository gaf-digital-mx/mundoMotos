{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @mundomotos/api exec wrangler dev --port 8789 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "url": ["http://127.0.0.1:8789/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
